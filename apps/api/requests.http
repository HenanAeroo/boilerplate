### ================================
### GLOBAL VARIABLES
### ================================

@baseUrl = http://localhost:3000
@accessToken = 

### ================================
### AUTH - LOCAL SIGN UP
### ================================

POST {{baseUrl}}/auth/sign-up
Content-Type: application/json

{
  "email": "john.doe@test.com",
  "password": "StrongPassword123!",
  "firstName": "John",
  "lastName": "Doe"
}

###

### ================================
### AUTH - LOCAL SIGN IN
### ================================

POST {{baseUrl}}/auth/sign-in
Content-Type: application/json

{
  "email": "john.doe@test.com",
  "password": "StrongPassword123!"
}

###

### ================================
### AUTH - GOOGLE (REDIRECT)
### ================================

GET {{baseUrl}}/auth/google

###

### ================================
### AUTH - GOOGLE CALLBACK (SIMULATION)
### ================================

GET {{baseUrl}}/auth/google/callback?code=OAUTH_CODE_HERE

###

### ================================
### USERS - GET ALL (Protected)
### ================================

GET {{baseUrl}}/users
Authorization: Bearer {{accessToken}}

###

### ================================
### USERS - GET BY ID
### ================================

GET {{baseUrl}}/users/1
Authorization: Bearer {{accessToken}}

###

### ================================
### USERS - UPDATE
### ================================

PATCH {{baseUrl}}/users/1
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "firstName": "Johnny"
}

###

### ================================
### USERS - DELETE
### ================================

DELETE {{baseUrl}}/users/1
Authorization: Bearer {{accessToken}}