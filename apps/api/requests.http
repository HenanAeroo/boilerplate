@baseUrl = http://localhost:3000

### --------------------------------------------------

### Create user

### --------------------------------------------------

POST {{baseUrl}}/users/create
Content-Type: application/json

{
"email": "[john.doe@example.com](mailto:john.doe@example.com)",
"first_name": "John",
"last_name": "Doe"
}

### --------------------------------------------------

### Get all users

### --------------------------------------------------

GET {{baseUrl}}/users

### --------------------------------------------------

### Get one user by id

### --------------------------------------------------

GET {{baseUrl}}/users/1

### --------------------------------------------------

### Update user

### --------------------------------------------------

PATCH {{baseUrl}}/users/1
Content-Type: application/json

{
"first_name": "Johnny",
"last_name": "Doe Updated"
}

### --------------------------------------------------

### Delete user

### --------------------------------------------------

DELETE {{baseUrl}}/users/1
